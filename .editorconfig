# EditorConfig — https://editorconfig.org
# Top-level config for the Ollie monorepo.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown — trailing whitespace can be a hard line break.
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.sql]
indent_size = 2
