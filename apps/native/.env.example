# apps/native — required env vars
# Copy to .env.local and fill in real values.
# Never commit .env.local.

# ── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# ── Cloudflare Workers ────────────────────────────────────────────────────────
# AI proxy (brain-dump, enrich-dump, ingest-event, label, invites)
VITE_AI_PROXY_URL=https://ollie-api.ollieapp.workers.dev

# APNs push worker
VITE_APNS_PUSH_URL=https://ollie-apns.ollieapp.workers.dev

# Sentry tunnel worker (Turkish ISP DPI bypass + hostname masking)
VITE_SENTRY_TUNNEL_URL=https://ollie-sentry.ollieapp.workers.dev

# ── iOS APNs push-token registration ──────────────────────────────────────────
# Worker /register-token endpoint + shared secret. The secret MUST equal the
# worker's REGISTER_SHARED_SECRET. Do not commit a real secret.
# VITE_PUSH_REGISTER_URL=https://ollie-apns.ollieapp.workers.dev/register-token
# VITE_PUSH_REGISTER_SECRET=
