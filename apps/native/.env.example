# apps/native — required env vars
# Copy to .env.local and fill in real values.
# Never commit .env.local.

# ── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# ── Cloudflare Workers ────────────────────────────────────────────────────────
# AI proxy (brain-dump, enrich-dump, ingest-event, label, invites)
VITE_AI_PROXY_URL=https://ollie-api.ollieapp.workers.dev

# APNs push worker
VITE_APNS_PUSH_URL=https://ollie-apns.ollieapp.workers.dev

# Sentry tunnel worker (Turkish ISP DPI bypass + hostname masking)
VITE_SENTRY_TUNNEL_URL=https://ollie-sentry.ollieapp.workers.dev

# ── Clerk (auth) ──────────────────────────────────────────────────────────────
# Publishable key from Clerk dashboard → API keys. Starts with pk_test_… for
# dev instances, pk_live_… for production. Safe to ship to the client; this is
# the public-facing identifier for your Clerk instance.
VITE_CLERK_PUBLISHABLE_KEY=

# ── /route/dump (v2 brain-dump router) ────────────────────────────────────────
# Endpoint override (defaults to the same VITE_AI_PROXY_URL above). For
# staging-vs-prod splits, point this at the staging worker:
#   https://ollie-ai-proxy-staging.ollieapp.workers.dev
VITE_ROUTE_DUMP_URL=

# Dev-mode bearer token. Required only until Clerk is wired into the native
# app (T0 phase 3). Matches the STAGING_TEST_BEARER on the staging worker —
# /route/dump bypasses Clerk JWT verify when the incoming Bearer equals this
# shared secret. NEVER ship to prod.
VITE_DEV_DUMP_BEARER=
