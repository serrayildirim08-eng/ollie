{
  "appId": "app.ollie.ollie",
  "appName": "ollie",
  "webDir": "./www",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": []
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false,
    "scheme": "ollie",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1000,
      "backgroundColor": "#F2EEE4"
    },
    "StatusBar": {
      "style": "DEFAULT",
      "backgroundColor": "#F2EEE4"
    },
    "CapacitorHttp": {
      "enabled": false
    }
  }
}
