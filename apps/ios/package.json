{
  "name": "@ollie/ios",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "description": "Capacitor iOS shell for Ollie",
  "scripts": {
    "add": "cap add ios",
    "sync": "cap sync ios",
    "open": "cap open ios",
    "run": "cap run ios",
    "build": "pnpm --filter @ollie/web build && node -e \"const{cpSync}=require('fs');cpSync('../web/dist','./www',{recursive:true,force:true})\" && cap sync ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0"
  },
  "dependencies": {
    "@sentry/capacitor": "^4.0.0"
  }
}
