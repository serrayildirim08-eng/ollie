# ollie · client-safe env vars. Copy to .env.local and fill in.
# Anything with VITE_ prefix is bundled into the client — NEVER put
# private keys here. Worker-only secrets live in each worker's README.

# Cloudflare Workers (deployed URLs from `wrangler deploy`)
VITE_APNS_WORKER_URL=
VITE_AI_WORKER_URL=

# Sentry (project DSN — safe to ship in client per Sentry docs)
VITE_SENTRY_DSN=

# Supabase (anon key is intentionally client-safe; service-role key is NOT)
SUPABASE_URL=
SUPABASE_ANON_KEY=
