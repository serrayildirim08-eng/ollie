# ollie · client-safe env vars. Copy to .env.local and fill in.
# Anything with VITE_ prefix is bundled into the client — NEVER put
# private keys here. Worker-only secrets live in each worker's README.

# Cloudflare Workers (deployed URLs from `wrangler deploy`)
VITE_APNS_WORKER_URL=
VITE_AI_WORKER_URL=
# Plaid sync worker — POST /link/token/create, /exchange, /webhook, GET /health
# Leave empty in development to hide the PlaidLinkButton (sandbox keys live
# in the worker, not in the client bundle). When unset, onboarding's bank-link
# screen renders the "skip" CTA only.
VITE_PLAID_SYNC_WORKER_URL=

# Plaid sandbox credentials — for `pnpm -F @ollie/plaid smoke` ONLY.
# These NEVER ship to the client. Get from https://dashboard.plaid.com/team/keys
# Production keys go ONLY into the workers/plaid-sync worker via
# `wrangler secret put PLAID_CLIENT_ID|PLAID_SECRET`.
PLAID_CLIENT_ID=
PLAID_SECRET=

# Sentry (project DSN — safe to ship in client per Sentry docs)
VITE_SENTRY_DSN=
# Sentry tunnel — Cloudflare Worker proxy URL. Bypasses DPI blocks
# (TR ISP blocks *.sentry.io at TLS layer; *.workers.dev unblocked).
# Leave empty to send envelopes directly to Sentry's ingest endpoint.
VITE_SENTRY_TUNNEL_URL=

# Supabase (anon key is intentionally client-safe; service-role key is NOT)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ───────────────────────────────────────────────────────────────────────────
# WORKER-ONLY SECRETS — NOT loaded from this file.
# These are set per-worker via `wrangler secret put` (see each worker's
# wrangler.toml + DEPLOY_TODO.md). Listed here only so the full set is
# discoverable in one place. Do NOT put values next to these names here.
#
#   ollie-plaid-sync:
#     SUPABASE_ANON_KEY        — NEW (2026-05-17 S1 fix). Used to verify
#                                user JWTs on the authed plaid endpoints.
#   ollie-ai-proxy:
#     SUPABASE_ANON_KEY        — now also required by /ingest-event,
#                                /label, /enrich-dump (S2 fix).
#   ollie-apns-push:
#     APNS_INTERNAL_SECRET     — NEW (2026-05-17 S3 fix). Shared secret for
#                                the internal /push endpoint.
#   ollie-cron:
#     APNS_INTERNAL_SECRET     — NEW. Must equal ollie-apns-push's value.
# ───────────────────────────────────────────────────────────────────────────
